[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://entities/player/characters/character_data.gd" id="1_data"]
[ext_resource type="Script" path="res://core/stats/stat_modifier.gd" id="2_modifier"]
[ext_resource type="Resource" path="res://data/weapons/sword.tres" id="3_weapon"]
[ext_resource type="PackedScene" path="res://entities/player/characters/passives/endurance.tscn" id="4_passive"]

[sub_resource type="Resource" id="Resource_health"]
script = ExtResource("2_modifier")
stat = &"max_health"
value = 30.0

[sub_resource type="Resource" id="Resource_armor"]
script = ExtResource("2_modifier")
stat = &"armor"
value = 5.0

[sub_resource type="Resource" id="Resource_run"]
script = ExtResource("2_modifier")
stat = &"run_speed"
kind = 1
value = -0.05

[sub_resource type="Resource" id="Resource_sprint"]
script = ExtResource("2_modifier")
stat = &"sprint_speed"
kind = 1
value = -0.05

[sub_resource type="Resource" id="Resource_dash"]
script = ExtResource("2_modifier")
stat = &"dash_duration"
kind = 1
value = 0.3

[resource]
script = ExtResource("1_data")
stat_modifiers = Array[ExtResource("2_modifier")]([SubResource("Resource_health"), SubResource("Resource_armor"), SubResource("Resource_run"), SubResource("Resource_sprint"), SubResource("Resource_dash")])
name_key = &"CHARACTER_WARRIOR_NAME"
description_key = &"CHARACTER_WARRIOR_DESCRIPTION"
color = Color(0.85, 0.32, 0.25, 1)
starting_weapon = ExtResource("3_weapon")
passive = ExtResource("4_passive")
passive_name_key = &"PASSIVE_ENDURANCE_NAME"
passive_description_key = &"PASSIVE_ENDURANCE_DESCRIPTION"
