[ext_resource type="Resource" uid="uid://d3gftqdyp8ot8" path="res://data/weapons/sword.tres" id="3_weapon"]
[ext_resource type="PackedScene" path="res://entities/player/characters/passives/veteran.tscn" id="4_passive"]
[ext_resource type="Script" uid="uid://0j8d013ejauu" path="res://entities/player/characters/model/model_attachment.gd" id="5_attachment"]
[ext_resource type="PackedScene" path="res://assets/models/props/sword.tscn" id="6_sword"]
[ext_resource type="PackedScene" path="res://assets/models/props/shield.tscn" id="7_shield"]
[ext_resource type="Texture2D" uid="uid://dqwbvdadcuyba" path="res://assets/textures/icons/characters/warrior.svg" id="98_icon"]

[sub_resource type="Resource" id="Resource_sword"]
script = ExtResource("5_attachment")
scene = ExtResource("6_sword")
socket = &"HandRight"
transform = Transform3D(1.15, 0, 0, 0, 0.996, 0.575, 0, -0.575, 0.996, 0, 0, 0)

[sub_resource type="Resource" id="Resource_shield"]
script = ExtResource("5_attachment")
scene = ExtResource("7_shield")
socket = &"HandLeft"
transform = Transform3D(0.906, 0, 0.423, 0, 1, 0, -0.423, 0, 0.906, 0, 0, -0.15)

[sub_resource type="Resource" id="Resource_health"]
script = ExtResource("2_modifier")
stat = &"max_health"
value = 30.0

[sub_resource type="Resource" id="Resource_armor"]
script = ExtResource("2_modifier")
stat = &"armor"
value = 5.0

[sub_resource type="Resource" id="Resource_run"]
script = ExtResource("2_modifier")
stat = &"run_speed"
kind = 1
value = -0.05

[sub_resource type="Resource" id="Resource_sprint"]
script = ExtResource("2_modifier")
stat = &"sprint_speed"
kind = 1
value = -0.05

[sub_resource type="Resource" id="Resource_dash"]
script = ExtResource("2_modifier")
stat = &"dash_duration"
kind = 1
value = 0.3

[sub_resource type="Resource" id="Resource_regen"]
script = ExtResource("2_modifier")
stat = &"health_regen"
value = 0.8

[resource]
script = ExtResource("1_data")
id = &"warrior"
name_key = &"CHARACTER_WARRIOR_NAME"
description_key = &"CHARACTER_WARRIOR_DESCRIPTION"
color = Color(0.85, 0.32, 0.25, 1)
icon = ExtResource("98_icon")
starting_weapon = ExtResource("3_weapon")
passive = ExtResource("4_passive")
passive_name_key = &"PASSIVE_VETERAN_NAME"
passive_description_key = &"PASSIVE_VETERAN_DESCRIPTION"
attachments = Array[ExtResource("5_attachment")]([SubResource("Resource_sword"), SubResource("Resource_shield")])
stat_modifiers = Array[ExtResource("2_modifier")]([SubResource("Resource_health"), SubResource("Resource_armor"), SubResource("Resource_run"), SubResource("Resource_sprint"), SubResource("Resource_dash"), SubResource("Resource_regen")])
