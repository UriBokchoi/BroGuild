[gd_resource type="Resource" script_class="CharacterData" format=3]

[ext_resource type="Script" path="res://entities/player/characters/character_data.gd" id="1_data"]
[ext_resource type="Script" path="res://core/stats/stat_modifier.gd" id="2_modifier"]
[ext_resource type="Resource" path="res://data/weapons/dagger.tres" id="3_weapon"]
[ext_resource type="PackedScene" path="res://entities/player/characters/passives/lethal.tscn" id="4_passive"]
[ext_resource type="Script" path="res://entities/player/characters/model/model_attachment.gd" id="5_attachment"]
[ext_resource type="PackedScene" path="res://assets/models/props/dagger.tscn" id="6_dagger"]

[sub_resource type="Resource" id="Resource_health"]
script = ExtResource("2_modifier")
stat = &"max_health"
value = -10.0

[sub_resource type="Resource" id="Resource_run"]
script = ExtResource("2_modifier")
stat = &"run_speed"
kind = 1
value = 0.1

[sub_resource type="Resource" id="Resource_sprint"]
script = ExtResource("2_modifier")
stat = &"sprint_speed"
kind = 1
value = 0.1

[sub_resource type="Resource" id="Resource_crit"]
script = ExtResource("2_modifier")
stat = &"crit_chance"
value = 10.0

[sub_resource type="Resource" id="Resource_stamina"]
script = ExtResource("2_modifier")
stat = &"max_charges"
value = 1.0

[sub_resource type="Resource" id="Resource_air_jumps"]
script = ExtResource("2_modifier")
stat = &"air_jumps"
value = 1.0

[sub_resource type="Resource" id="Resource_dagger_right"]
script = ExtResource("5_attachment")
scene = ExtResource("6_dagger")
socket = &"HandRight"
transform = Transform3D(1.35, 0, 0, 0, 1.106, 0.775, 0, -0.775, 1.106, 0, 0, 0)

[sub_resource type="Resource" id="Resource_dagger_left"]
script = ExtResource("5_attachment")
scene = ExtResource("6_dagger")
socket = &"HandLeft"
transform = Transform3D(1.35, 0, 0, 0, 1.106, 0.775, 0, -0.775, 1.106, 0, 0, 0)

[resource]
script = ExtResource("1_data")
stat_modifiers = Array[ExtResource("2_modifier")]([SubResource("Resource_health"), SubResource("Resource_run"), SubResource("Resource_sprint"), SubResource("Resource_crit"), SubResource("Resource_stamina"), SubResource("Resource_air_jumps")])
name_key = &"CHARACTER_ROGUE_NAME"
description_key = &"CHARACTER_ROGUE_DESCRIPTION"
color = Color(0.3, 0.85, 0.5, 1)
starting_weapon = ExtResource("3_weapon")
passive = ExtResource("4_passive")
passive_name_key = &"PASSIVE_LETHAL_NAME"
passive_description_key = &"PASSIVE_LETHAL_DESCRIPTION"
attachments = Array[ExtResource("5_attachment")]([SubResource("Resource_dagger_right"), SubResource("Resource_dagger_left")])
