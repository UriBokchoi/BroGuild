&"bomb": SubResource("Cue_pickup_bomb"),
&"energy": SubResource("Cue_pickup_energy"),
&"experience": SubResource("Cue_pickup_experience"),
&"gold": SubResource("Cue_pickup_gold"),
&"heal": SubResource("Cue_pickup_heal"),
&"magnet": SubResource("Cue_pickup_magnet"),
&"time_stop": SubResource("Cue_pickup_time_stop")
})
streak_reward = &"experience"
streak_window = 0.4
streak_max_semitones = 12
breakable_broken = SubResource("Cue_breakable_broken")
chest_opened = SubResource("Cue_chest_opened")
item_revealed = SubResource("Cue_item_revealed")
chest_denied = SubResource("Cue_denied")
slot_spun = SubResource("Cue_slot_spun")
slot_results = Dictionary[StringName, ExtResource("2_cue")]({
&"SLOT_CURSE_ELITES": SubResource("Cue_curse"),
&"SLOT_CURSE_FRAILTY": SubResource("Cue_curse"),
&"SLOT_NOTHING": SubResource("Cue_slot_lost"),
&"SLOT_NOT_ENOUGH_GOLD": SubResource("Cue_denied")
})
slot_won = SubResource("Cue_slot_won")
slot_jackpot = SubResource("Cue_slot_jackpot")
upgrade_spin_tick = SubResource("Cue_upgrade_spin_tick")
upgrade_revealed = SubResource("Cue_upgrade_revealed")
reveal_pitches = Dictionary[StringName, float]({
&"common": 1.0,
&"improbable": 1.2599,
&"legendary": 1.4983,
&"mythic": 2.0,
&"rare": 1.1225
})
button_pressed = SubResource("Cue_button_pressed")
horde_incoming = SubResource("Cue_horde_incoming")
synergies = Dictionary[StringName, ExtResource("2_cue")]({
&"dash_wave_damage": SubResource("Cue_synergy_dash_wave"),
&"slam_damage": SubResource("Cue_synergy_slam")
})
double_won = SubResource("Cue_double_won")
double_lost = SubResource("Cue_double_lost")
