[gd_resource type="Resource" script_class="RuneData" format=3]

[ext_resource type="Script" path="res://systems/upgrades/runes/rune_data.gd" id="1_rune"]
[ext_resource type="Texture2D" path="res://assets/textures/icons/runes/multiplicity.svg" id="99_icon"]
[ext_resource type="Script" path="res://systems/upgrades/upgrade_stat.gd" id="90_upgrade"]

[sub_resource type="Resource" id="Upgrade_projectile_count"]
script = ExtResource("90_upgrade")
stat = &"projectile_count"
value = 0.68
fixed = 0.56
step = 0.1

[resource]
script = ExtResource("1_rune")
id = &"multiplicity"
icon = ExtResource("99_icon")
name_key = &"RUNE_MULTIPLICITY_NAME"
description_key = &"RUNE_MULTIPLICITY_DESCRIPTION"
level_cap = 20
upgrade_stats = Array[ExtResource("90_upgrade")]([SubResource("Upgrade_projectile_count")])
