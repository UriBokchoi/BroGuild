[gd_resource type="Resource" script_class="RuneData" format=3]

[ext_resource type="Script" path="res://systems/upgrades/runes/rune_data.gd" id="1_rune"]
[ext_resource type="Texture2D" path="res://assets/textures/icons/runes/vigor.svg" id="99_icon"]
[ext_resource type="Script" path="res://systems/upgrades/upgrade_stat.gd" id="90_upgrade"]

[sub_resource type="Resource" id="Upgrade_max_health"]
script = ExtResource("90_upgrade")
stat = &"max_health"
value = 20.0

[resource]
script = ExtResource("1_rune")
id = &"vigor"
icon = ExtResource("99_icon")
name_key = &"RUNE_VIGOR_NAME"
description_key = &"RUNE_VIGOR_DESCRIPTION"
level_cap = 20
upgrade_stats = Array[ExtResource("90_upgrade")]([SubResource("Upgrade_max_health")])
