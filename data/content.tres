[sub_resource type="Resource" id="Category_characters"]
script = ExtResource("2_category")
id = &"characters"
name_key = &"ARCHIVE_CATEGORY_CHARACTERS"
hint_key = &"ARCHIVE_HINT_CHARACTERS"
entries = Array[Resource]([ExtResource("10_warrior"), ExtResource("11_mage"), ExtResource("12_rogue")])

[sub_resource type="Resource" id="Category_weapons"]
script = ExtResource("2_category")
id = &"weapons"
name_key = &"ARCHIVE_CATEGORY_WEAPONS"
hint_key = &"ARCHIVE_HINT_WEAPONS"
shown_stats = Array[StringName]([&"damage", &"cooldown", &"projectiles", &"area", &"reach"])
entries = Array[Resource]([ExtResource("13_sword"), ExtResource("14_staff"), ExtResource("15_dagger")])

[sub_resource type="Resource" id="Category_runes"]
script = ExtResource("2_category")
id = &"runes"
name_key = &"ARCHIVE_CATEGORY_RUNES"
hint_key = &"ARCHIVE_HINT_RUNES"
entries = Array[Resource]([ExtResource("16_strength"), ExtResource("17_amplitude"), ExtResource("18_haste"), ExtResource("19_vigor"), ExtResource("20_multiplicity")])

[sub_resource type="Resource" id="Category_items"]
script = ExtResource("2_category")
id = &"items"
name_key = &"ARCHIVE_CATEGORY_ITEMS"
hint_key = &"ARCHIVE_HINT_ITEMS"
entries = Array[Resource]([ExtResource("21_cold_pizza"), ExtResource("22_fanny_pack"), ExtResource("23_game_controller"), ExtResource("24_horseshoe"), ExtResource("25_mead"), ExtResource("26_protein_shake"), ExtResource("27_rye_bread"), ExtResource("28_backwards_cap"), ExtResource("29_bluetooth_speaker"), ExtResource("30_scratch_card"), ExtResource("31_socks_and_sandals"), ExtResource("32_torch"), ExtResource("33_travel_cloak"), ExtResource("43a_flaming_sneakers"), ExtResource("43b_air_horn"), ExtResource("34_body_oil"), ExtResource("35_lifting_belt"), ExtResource("36_pocket_crossbow"), ExtResource("37_sunglasses"), ExtResource("43c_championship_belt"), ExtResource("38_brass_grail"), ExtResource("39_gold_chain"), ExtResource("40_golden_dumbbell"), ExtResource("41_shady_shake"), ExtResource("42_bro_crown"), ExtResource("43_excalibro")])

[sub_resource type="Resource" id="Category_enemies"]
script = ExtResource("2_category")
id = &"enemies"
name_key = &"ARCHIVE_CATEGORY_ENEMIES"
hint_key = &"ARCHIVE_HINT_ENEMIES"
shown_stats = Array[StringName]([&"max_health", &"contact_damage", &"move_speed"])
entries = Array[Resource]([ExtResource("44_swarmer"), ExtResource("45_shooter"), ExtResource("46_sapling"), ExtResource("48_trolleador"), ExtResource("47_ent_trainer")])

[resource]
script = ExtResource("1_catalog")
categories = Array[ExtResource("2_category")]([SubResource("Category_characters"), SubResource("Category_weapons"), SubResource("Category_runes"), SubResource("Category_items"), SubResource("Category_enemies")])
