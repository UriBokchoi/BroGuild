[gd_resource type="Resource" script_class="PassiveItemData" format=3]

[ext_resource type="Script" path="res://systems/items/passive_item_data.gd" id="1_item"]
[ext_resource type="Script" path="res://systems/items/effects/on_hit_effect.gd" id="2_effect"]
[ext_resource type="Script" path="res://systems/items/effects/slow_on_hit.gd" id="3_slow"]
[ext_resource type="Resource" path="res://data/rarities/rare.tres" id="4_rarity"]
[ext_resource type="Texture2D" path="res://assets/textures/icons/items/cold_spray.svg" id="5_icon"]

[sub_resource type="Resource" id="Effect_slow"]
script = ExtResource("3_slow")
speed_factor = 0.6
duration = 2.0
chance = 20.0
describe_key = &"ON_HIT_SLOW"

[resource]
script = ExtResource("1_item")
id = &"cold_spray"
name_key = &"ITEM_COLD_SPRAY_NAME"
description_key = &"ITEM_COLD_SPRAY_DESCRIPTION"
icon = ExtResource("5_icon")
rarity = ExtResource("4_rarity")
on_hit = Array[ExtResource("2_effect")]([SubResource("Effect_slow")])
