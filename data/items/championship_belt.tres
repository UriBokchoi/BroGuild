[gd_resource type="Resource" script_class="PassiveItemData" format=3]

[ext_resource type="Script" path="res://systems/items/passive_item_data.gd" id="1_item"]
[ext_resource type="Script" path="res://core/stats/stat_modifier.gd" id="2_modifier"]
[ext_resource type="Resource" path="res://data/rarities/improbable.tres" id="3_rarity"]
[ext_resource type="Texture2D" path="res://assets/textures/icons/items/championship_belt.svg" id="4_icon"]

[sub_resource type="Resource" id="Modifier_1"]
script = ExtResource("2_modifier")
stat = &"slam_damage"
value = 40.0

[resource]
script = ExtResource("1_item")
