[resource]
script = ExtResource("1_data")
id = &"bat"
name_key = &"ENEMY_BAT_NAME"
description_key = &"ENEMY_BAT_DESCRIPTION"
icon = ExtResource("98_icon")
color = Color(0.45, 0.25, 0.62, 1)
scene = ExtResource("4_scene")
