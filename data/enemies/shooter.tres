[gd_resource type="Resource" script_class="EnemyData" format=3]

[ext_resource type="Script" path="res://entities/enemies/enemy_data.gd" id="1_data"]
[ext_resource type="Script" path="res://core/components/health/health_data.gd" id="2_health"]
[ext_resource type="Script" path="res://entities/enemies/enemy_stats.gd" id="3_stats"]
[ext_resource type="PackedScene" path="res://entities/enemies/shooter/shooter.tscn" id="4_scene"]
[ext_resource type="Script" path="res://systems/combat/weapons/weapon_data.gd" id="5_weapon_data"]
[ext_resource type="Resource" path="res://data/enemies/weapons/shooter_gun.tres" id="6_gun"]

[sub_resource type="Resource" id="Resource_health"]
script = ExtResource("2_health")
max_health = 26.0

[sub_resource type="Resource" id="Resource_stats"]
script = ExtResource("3_stats")
move_speed = 3.1
acceleration = 20.0
contact_damage = 4.0
contact_interval = 0.8
knockback = 3.0
separation_radius = 1.4
separation_weight = 0.6
approach_spread = 40.0
keep_distance = 11.0
xp_reward = 2.6
gold_reward = 2.6

[resource]
script = ExtResource("1_data")
id = &"shooter"
name_key = &"ENEMY_SHOOTER_NAME"
description_key = &"ENEMY_SHOOTER_DESCRIPTION"
scene = ExtResource("4_scene")
stat_sources = Array[Resource]([SubResource("Resource_health"), SubResource("Resource_stats")])
weapons = Array[ExtResource("5_weapon_data")]([ExtResource("6_gun")])
