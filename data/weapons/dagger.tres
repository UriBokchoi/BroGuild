[gd_resource type="Resource" script_class="WeaponData" format=3]

[ext_resource type="Script" path="res://systems/combat/weapons/weapon_data.gd" id="1_data"]
[ext_resource type="Script" path="res://systems/combat/weapons/dagger/dagger_stats.gd" id="2_stats"]
[ext_resource type="PackedScene" path="res://systems/combat/weapons/dagger/dagger.tscn" id="5_scene"]
[ext_resource type="Texture2D" path="res://assets/textures/icons/weapons/dagger.svg" id="99_icon"]
[ext_resource type="Script" path="res://systems/upgrades/upgrade_stat.gd" id="90_upgrade"]

[sub_resource type="Resource" id="Resource_stats"]
script = ExtResource("2_stats")
damage = 15.0
cooldown = 0.7
projectiles = 1
burst_interval = 0.1
area = 100.0
duration = 1.2
reach = 16.0
projectile_speed = 30.0
bounce_range = 6.0
bounces = 2

[sub_resource type="Resource" id="Upgrade_damage"]
script = ExtResource("90_upgrade")
stat = &"damage"
value = 2.5

[sub_resource type="Resource" id="Upgrade_projectiles"]
script = ExtResource("90_upgrade")
stat = &"projectiles"
value = 1.0
whole_numbers = true
weight = 0.5

[sub_resource type="Resource" id="Upgrade_bounces"]
script = ExtResource("90_upgrade")
stat = &"bounces"
value = 1.0
whole_numbers = true

[sub_resource type="Resource" id="Upgrade_projectile_speed"]
script = ExtResource("90_upgrade")
stat = &"projectile_speed"
kind = 1
value = 0.1

[sub_resource type="Resource" id="Upgrade_cooldown"]
script = ExtResource("90_upgrade")
stat = &"cooldown"
kind = 2
value = 0.94

[resource]
script = ExtResource("1_data")
id = &"dagger"
icon = ExtResource("99_icon")
name_key = &"WEAPON_DAGGER_NAME"
description_key = &"WEAPON_DAGGER_DESCRIPTION"
scene = ExtResource("5_scene")
stats = SubResource("Resource_stats")
level_cap = 10
upgrade_stats = Array[ExtResource("90_upgrade")]([SubResource("Upgrade_damage"), SubResource("Upgrade_projectiles"), SubResource("Upgrade_bounces"), SubResource("Upgrade_projectile_speed"), SubResource("Upgrade_cooldown")])
