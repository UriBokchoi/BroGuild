[gd_resource type="Resource" script_class="WeaponData" format=3]

[ext_resource type="Script" path="res://systems/combat/weapons/weapon_data.gd" id="1_data"]
[ext_resource type="Script" path="res://systems/combat/weapons/staff/staff_stats.gd" id="2_stats"]
[ext_resource type="Script" path="res://core/stats/stat_modifier_set.gd" id="3_set"]
[ext_resource type="Script" path="res://core/stats/stat_modifier.gd" id="4_modifier"]
[ext_resource type="PackedScene" path="res://systems/combat/weapons/staff/staff.tscn" id="5_scene"]
[ext_resource type="Texture2D" path="res://assets/textures/icons/weapons/staff.svg" id="99_icon"]

[sub_resource type="Resource" id="Resource_stats"]
script = ExtResource("2_stats")
damage = 18.0
cooldown = 1.5
projectiles = 1
burst_interval = 0.25
area = 100.0
duration = 2.5
reach = 14.0
projectile_speed = 12.0
explosion_radius = 2.0

[sub_resource type="Resource" id="Resource_level2_damage"]
script = ExtResource("4_modifier")
stat = &"damage"
value = 6.0

[sub_resource type="Resource" id="Resource_level2"]
script = ExtResource("3_set")
stat_modifiers = Array[ExtResource("4_modifier")]([SubResource("Resource_level2_damage")])

[sub_resource type="Resource" id="Resource_level3_radius"]
script = ExtResource("4_modifier")
stat = &"explosion_radius"
value = 0.5

[sub_resource type="Resource" id="Resource_level3"]
script = ExtResource("3_set")
stat_modifiers = Array[ExtResource("4_modifier")]([SubResource("Resource_level3_radius")])

[sub_resource type="Resource" id="Resource_level4_projectiles"]
script = ExtResource("4_modifier")
stat = &"projectiles"
value = 1.0

[sub_resource type="Resource" id="Resource_level4"]
script = ExtResource("3_set")
stat_modifiers = Array[ExtResource("4_modifier")]([SubResource("Resource_level4_projectiles")])

[sub_resource type="Resource" id="Resource_level5_damage"]
script = ExtResource("4_modifier")
stat = &"damage"
value = 10.0

[sub_resource type="Resource" id="Resource_level5_cooldown"]
script = ExtResource("4_modifier")
stat = &"cooldown"
kind = 1
value = -0.2

[sub_resource type="Resource" id="Resource_level5"]
script = ExtResource("3_set")
stat_modifiers = Array[ExtResource("4_modifier")]([SubResource("Resource_level5_damage"), SubResource("Resource_level5_cooldown")])

[resource]
script = ExtResource("1_data")
id = &"staff"
icon = ExtResource("99_icon")
name_key = &"WEAPON_STAFF_NAME"
description_key = &"WEAPON_STAFF_DESCRIPTION"
scene = ExtResource("5_scene")
stats = SubResource("Resource_stats")
levels = Array[ExtResource("3_set")]([SubResource("Resource_level2"), SubResource("Resource_level3"), SubResource("Resource_level4"), SubResource("Resource_level5")])
