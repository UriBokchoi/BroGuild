[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/quests/quests_panel.gd" id="1_panel"]
[ext_resource type="Resource" path="res://data/meta/quests.tres" id="2_catalog"]

[node name="QuestsPanel" type="PanelContainer"]
custom_minimum_size = Vector2(600, 0)
size_flags_horizontal = 4
size_flags_vertical = 3
script = ExtResource("1_panel")
catalog = ExtResource("2_catalog")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"MenuList"

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "QUESTS_TITLE"

[node name="Scroll" type="ScrollContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Content/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StatList"

[node name="Back" type="Button" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
text = "OPTIONS_BACK"
