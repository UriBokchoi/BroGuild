[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/leaderboard/leaderboard_panel.gd" id="1_panel"]
[ext_resource type="Resource" path="res://data/content.tres" id="2_catalog"]
[ext_resource type="PackedScene" path="res://ui/menus/leaderboard/build_chip.tscn" id="3_chip"]

[node name="LeaderboardPanel" type="PanelContainer"]
custom_minimum_size = Vector2(360, 0)
size_flags_vertical = 3
script = ExtResource("1_panel")
catalog = ExtResource("2_catalog")
chip = ExtResource("3_chip")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"MenuList"

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "RECORDS_TITLE"

[node name="Subtitle" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"StatBaseLabel"
text = "RECORDS_SUBTITLE"
autowrap_mode = 3

[node name="Empty" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatNameLabel"
text = "RECORDS_EMPTY"
autowrap_mode = 3

[node name="ListScroll" type="ScrollContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Content/ListScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StatList"

[node name="Detail" type="ScrollContainer" parent="Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 1.3
horizontal_scroll_mode = 0

[node name="DetailContent" type="VBoxContainer" parent="Content/Detail"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardColumn"

[node name="DetailTitle" type="Label" parent="Content/Detail/DetailContent"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitleLabel"

[node name="DetailRows" type="GridContainer" parent="Content/Detail/DetailContent"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsGrid"
columns = 2

[node name="Build" type="VBoxContainer" parent="Content/Detail/DetailContent"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardColumn"
