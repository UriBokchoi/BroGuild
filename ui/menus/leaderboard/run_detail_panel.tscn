[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/leaderboard/run_detail_panel.gd" id="1_panel"]
[ext_resource type="Resource" path="res://data/content.tres" id="2_catalog"]
[ext_resource type="PackedScene" path="res://ui/menus/leaderboard/build_chip.tscn" id="3_chip"]

[node name="RunDetailPanel" type="PanelContainer"]
custom_minimum_size = Vector2(480, 0)
size_flags_horizontal = 4
size_flags_vertical = 3
script = ExtResource("1_panel")
catalog = ExtResource("2_catalog")
chip = ExtResource("3_chip")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"MenuList"

[node name="Title" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"

[node name="Scroll" type="ScrollContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Content/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardColumn"

[node name="Rows" type="GridContainer" parent="Content/Scroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"OptionsGrid"
columns = 2

[node name="Build" type="VBoxContainer" parent="Content/Scroll/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardColumn"

[node name="Back" type="Button" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
text = "OPTIONS_BACK"
