layout_mode = 2
theme_type_variation = &"StatList"

[node name="DisplayHeader" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"StatGroupLabel"
text = "OPTIONS_GROUP_DISPLAY"

[node name="Display" type="GridContainer" parent="Content"]
layout_mode = 2
theme_type_variation = &"OptionsGrid"
