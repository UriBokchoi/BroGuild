root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript y shaders: tabuladores, como el editor de Godot.
[*.{gd,gdshader}]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml,sh}]
indent_style = space
indent_size = 2

# En Markdown dos espacios finales son un salto de línea.
[*.md]
trim_trailing_whitespace = false
