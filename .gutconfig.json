{
  "dirs": ["res://tests"],
  "include_subdirs": true,
  "prefix": "test_",
  "suffix": ".gd",
  "should_exit": true,
  "ignore_pause": true,
  "log_level": 1,
  "hide_orphans": false,
  "disable_colors": true,
  "double_strategy": "SCRIPT_ONLY",
  "pre_run_script": "res://tests/hooks/pre_run.gd",
  "post_run_script": "res://tests/hooks/post_run.gd"
}
